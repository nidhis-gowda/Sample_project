# ------------------------------------------------------------------
# Dependencies / build output
# ------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.next/

# Build/coverage artefacts live at the repository root only, so these are
# anchored with a leading slash. Without the slash a pattern such as
# `coverage/` also matches *nested* directories at any depth, which silently
# excluded the real source directory `app/api/projects/[id]/coverage/` and
# shipped a build that was missing the Team Builder endpoint.
/out/
/build/
/dist/
/coverage/

# ------------------------------------------------------------------
# Environment files  (NEVER commit real secrets)
# ------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
.idea/
.vscode/*
!.vscode/extensions.json
__pycache__/
ml-service/.venv/
ml-service/venv/
*.py[cod]

# ------------------------------------------------------------------
# Local build / verification logs (regenerated, never committed)
# ------------------------------------------------------------------
*.log
*-out.txt
# ------------------------------------------------------------------
# Local runtime artefacts (Node portable runtime, local mongod data)
# ------------------------------------------------------------------
.tools/
.mongo-data/

