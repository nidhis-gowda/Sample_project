# ==================================================================
# Smart Employee Skill & Project Allocation Platform
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or real credentials to source control.
# ==================================================================

# ------------------------------------------------------------------
# 1. Database (MongoDB Atlas free tier works fine)
#    Create a free cluster: https://www.mongodb.com/cloud/atlas/register
#    Connection string format:
#    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# ------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=skill_allocation

# ------------------------------------------------------------------
# 2. Auth.js (NextAuth v5) — required
#    Generate a secret with:  npx auth secret   (or)  openssl rand -base64 32
# ------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------
# 3. Google OAuth (https://console.cloud.google.com/apis/credentials)
#    Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#    Also enable the "Google Calendar API" if you want calendar availability.
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# 4. Dev-only password-less demo login (email must already exist in DB).
#    Leave as "false" in production. Used so the app is usable locally
#    without Google OAuth credentials configured.
# ------------------------------------------------------------------
ENABLE_DEV_CREDENTIALS=false

# Comma separated list of emails that are promoted to ADMIN on first login.
ADMIN_EMAILS=

# ------------------------------------------------------------------
# 5. Optional Python FastAPI matching service.
#    If unreachable, the TypeScript matching engine is used automatically.
#    Run it with:  cd ml-service && uvicorn main:app --port 8000
# ------------------------------------------------------------------
MATCHING_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------
# 6. Application settings
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=SkillAlloc
NEXT_PUBLIC_APP_URL=http://localhost:3000