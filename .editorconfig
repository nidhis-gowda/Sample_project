root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown needs trailing double-spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Windows-only helper scripts must keep CRLF to stay runnable.
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Python follows PEP 8: four spaces.
[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
